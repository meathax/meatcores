<misterromdescription>
	<name>Primal Rage 2 RC1</name>
	<mratimestamp>202609221340</mratimestamp>
	<mameversion>0289</mameversion>
	<setname>primrag2</setname>
	<year>1997</year>
	<manufacturer>Atari</manufacturer>
	<category>Fighting</category>
	<rbf>Arcade-Primal2</rbf>
	<rotation>horizontal</rotation>
	<resolution>15kHz</resolution>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>

	<switches default="00">
		<!-- MAME documents S551:1, S551:3 and S551:4 as unknown; S551:2 selects the ZN BIOS test mode. -->
		<dip name="Unknown (S551:1)" bits="0" ids="Off,On" values="0,1"/>
		<dip name="BIOS Test Mode (S551:2)" bits="1" ids="Off,On" values="0,1"/>
		<dip name="Unknown (S551:3)" bits="2" ids="Off,On" values="0,1"/>
		<dip name="Unknown (S551:4)" bits="3" ids="Off,On" values="0,1"/>
	</switches>
	<buttons names="Light Punch,Medium Punch,Heavy Punch,Light Kick,Medium Kick,Heavy Kick,Start,Coin" default="A,B,X,Y,L,R,Start,Select"/>

	<!-- COH-1000W BIOS.  The parent archive supplies this device. -->
	<rom index="0" zip="primrag2.zip|coh1000w.zip">
		<part name="msm27c402zb.ic353" zip="coh1000w.zip" crc="45e8a4b4"/>
	</rom>

	<!-- MAME region roms: U14/U16 at offsets 0/1, U15/U17 at 0x100000/0x100001. -->
	<rom index="2" zip="primrag2.zip">
		<interleave output="16">
			<part name="pr2_036.u14" crc="c86450cd" map="01"/>
			<part name="pr2_036.u16" crc="3ee39e4f" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="pr2_036.u15" crc="4b24bd54" map="01"/>
			<part name="pr2_036.u17" crc="3681516c" map="10"/>
		</interleave>
	</rom>

	<!-- CAT702 key ordering follows the distinct ioctl indices consumed by PrimalRage2.sv. -->
	<rom index="4" zip="primrag2.zip|coh1000w.zip">
		<part name="tw01.ic652" zip="coh1000w.zip" crc="1cac067e"/>
	</rom>
	<rom index="5" zip="primrag2.zip">
		<part name="tw02" crc="583e8e1c"/>
	</rom>

	<!-- Factory AT28C16 image; index 9 is also the hps_io upload target. -->
	<rom index="9" zip="primrag2.zip">
		<part name="at28c16" crc="62c21283"/>
	</rom>
	<nvram index="9" size="2048"/>
</misterromdescription>
